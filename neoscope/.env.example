# ============================================================
# NeoScope — bí mật để trống; sao chép tệp này thành .env và không commit .env.
# ============================================================

# Nguồn LIVE mặc định: SSI FastConnect v3. Chuyển NEO khi chủ động dùng nguồn dự phòng.
NEOSCOPE_PROVIDER=SSI
# Chế độ dữ liệu: SYNTHETIC | LIVE
NEOSCOPE_MODE=SYNTHETIC

# VPBankS NEO API (nguồn dự phòng; chỉ dùng thông tin được cấp cho tài khoản)
NEO_USERNAME=
NEO_PASSWORD=
NEO_DEVICE_ID=

# SSI Developer Portal → API Key Management (quyền Market Data chỉ đọc).
SSI_CLIENT_ID=
SSI_API_KEY=
SSI_API_SECRET=
# Nếu entitlement Stream của SSI yêu cầu OTP, chỉ đặt trước khi chạy `neoscope record`.
# Không commit, chụp màn hình, hoặc ghi OTP vào manifest/log.
SSI_OTP=
